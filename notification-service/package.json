{
  "name": "notification-service",
  "version": "1.0.0",
  "description": "Notification Service for Evently Microservices - Email and Push Notifications",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "dotenv -e .env.dev nodemon src/server.ts",
    "dev:prod": "dotenv -e .env.prod nodemon src/server.ts",
    "start:dev": "dotenv -e .env.dev node dist/server.js",
    "start:prod": "dotenv -e .env.prod node dist/server.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "migrate:dev": "dotenv -e .env.dev -- prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "amqplib": "^0.10.9",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "prisma": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
